NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only - NUNCA prefixar com NEXT_PUBLIC_. Usada só em Server Actions
# (app/actions/users.ts) para criar/gerenciar usuários via Supabase Auth Admin.
# Pegue em Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
